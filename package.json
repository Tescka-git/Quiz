{
  "name": "kuikuiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:diagnostic:https": "node tooling/serve-diagnostic.mjs --https",
    "prepare:tls": "node tooling/prepare-local-tls.mjs",
    "test:tls": "node --test tests/tls/*.test.mjs",
    "probe:ping": "node tooling/ping-websocket.mjs",
    "doctor:android": "node tooling/android-doctor.mjs",
    "dev:diagnostic": "node tooling/serve-diagnostic.mjs",
    "test": "node --test --test-concurrency=1 tests/integration/*.test.mjs tests/engine/*.test.mjs tests/persistence/*.test.mjs",
    "test:persistence": "node --test tests/persistence/*.test.mjs",
    "build:engine": "node tooling/engine-build.mjs",
    "prepare:engine-probe": "node tooling/engine-build.mjs && node tooling/prepare-engine-probe.mjs",
    "prepare:recovery-probe": "node tooling/engine-build.mjs && node tooling/prepare-engine-probe.mjs --recovery",
    "test:engine": "node --test tests/engine/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
