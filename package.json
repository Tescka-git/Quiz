{
  "name": "kuikuiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:mock": "node tooling/engine-build.mjs && node apps/server-node/mock-server.mjs",
    "test:mock": "node --test tests/integration/mock-server.test.mjs",
    "test:mock:browser": "node tooling/test-mock-browser.mjs",
    "test:mock:live": "node tooling/test-live-quiz.mjs",
    "test:mock:pixel": "node tooling/test-pixel-player.mjs",
    "test:mock:android-recovery": "node tooling/test-android-quiz-recovery.mjs",
    "test:mock:android-tls": "node tooling/test-android-tls.mjs",
    "test:mock:android-modes": "node tooling/test-android-modes.mjs",
    "prepare:android-tls": "node tooling/provision-android-tls.mjs",
    "prepare:mock-android": "node tooling/engine-build.mjs && node tooling/prepare-engine-probe.mjs --recovery && node tooling/prepare-mock-assets.mjs",
    "dev:diagnostic:https": "node tooling/serve-diagnostic.mjs --https",
    "prepare:tls": "node tooling/prepare-local-tls.mjs",
    "test:tls": "node --test tests/tls/*.test.mjs",
    "probe:ping": "node tooling/ping-websocket.mjs",
    "doctor:android": "node tooling/android-doctor.mjs",
    "dev:diagnostic": "node tooling/serve-diagnostic.mjs",
    "test": "node --test --test-concurrency=1 tests/integration/*.test.mjs tests/engine/*.test.mjs tests/persistence/*.test.mjs",
    "test:persistence": "node --test tests/persistence/*.test.mjs",
    "build:engine": "node tooling/engine-build.mjs",
    "prepare:engine-probe": "node tooling/engine-build.mjs && node tooling/prepare-engine-probe.mjs",
    "prepare:recovery-probe": "node tooling/engine-build.mjs && node tooling/prepare-engine-probe.mjs --recovery",
    "test:engine": "node --test tests/engine/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ws": "8.23.0"
  }
}
